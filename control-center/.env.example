# Job Control Center configuration.
# Copy this file to `.env` and fill in the real values.

# Telegram bot token from @BotFather (required for Telegram features)
# Get one at https://t.me/BotFather -> /newbot
BOT_TOKEN=REPLACE_WITH_YOUR_BOT_TOKEN

# Your personal Telegram chat ID (user's chat, not the bot's)
CHAT_ID=6574417193

# Port the local control center listens on
PORT=3000

# Optional: base URL where BrowserOS sends events (usually unchanged)
LOG_ENDPOINT=/log

# Optional: Kilo Bridge VS Code extension endpoint (auto-detected when unset)
BRIDGE_URL=http://127.0.0.1:3011

# Optional: how long one bridge HTTP request may take before timing out (ms)
BRIDGE_TIMEOUT_MS=30000

# Optional: how many attempts the worker makes per bridge request
BRIDGE_RETRIES=3